<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vbox="VariableBox"
    >
    <Design.PreviewWith>
        <Border Padding="20">
            <!--  Add Controls for Previewer Here  -->
        </Border>
    </Design.PreviewWith>

    <!-- <Style Selector="NumericUpDown /template/ ButtonSpinner#PART_Spinner">
        <Setter Property="Background" Value="Transparent" />
        <Style Selector="^ /template/ :is(RepeatButton)">
            <Setter Property="Background" Value="Transparent" />
            <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Opacity" Value="0.4" />
            </Style>
        </Style>
    </Style> -->

    <Style Selector="ButtonSpinner">
        <Style Selector="^ /template/ :is(RepeatButton)">
            <Setter Property="Background" Value="Transparent" />
            <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Opacity" Value="0.4" />
            </Style>
        </Style>
    </Style>

    <Style Selector=":is(vbox|NumericUpDown)">
        <Style x:SetterTargetType="ButtonSpinner" Selector="^ /template/ #PART_Spinner">
            <Setter Property="Theme" Value="{StaticResource FluentButtonSpinner}" />
            <Style Selector="^ /template/ :is(RepeatButton)">
                <Setter Property="Background" Value="Transparent" />
                <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Opacity" Value="0.4" />
                </Style>
            </Style>
        </Style>
    </Style>
</Styles>
