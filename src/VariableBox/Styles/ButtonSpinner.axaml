<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vbox="clr-namespace:VariableBox;assembly=VariableBox"
    >
    <Design.PreviewWith>
        <Border Padding="20" Background="Gray">
            <StackPanel Spacing="10">
                <!--  Add Controls for Previewer Here  -->
                <ThemeVariantScope RequestedThemeVariant="Light">
                    <StackPanel Background="White" Orientation="Vertical">
                        <ButtonSpinner Content="aa" />
                        <ButtonSpinner Background="LightBlue" Content="aa" />
                    </StackPanel>
                </ThemeVariantScope>
                <ThemeVariantScope RequestedThemeVariant="Dark">
                    <StackPanel Background="Black" Orientation="Vertical">
                        <ButtonSpinner Content="aa" />
                        <ButtonSpinner Background="Blue" Content="aa" />
                    </StackPanel>
                </ThemeVariantScope>
            </StackPanel>
        </Border>
    </Design.PreviewWith>

    <Style Selector=":is(ButtonSpinner)">
        <Setter Property="Background" Value="Transparent" />
        <!-- <Setter Property="Background" Value="Green" /> -->

        <Style Selector="^ /template/ :is(Grid)">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="^ /template/ :is(Border)">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="^ /template/ :is(RepeatButton)">
            <!-- <Setter Property="Foreground" Value="{DynamicResource RepeatButtonForeground}" /> -->
            <!-- <Setter Property="Background" Value="{DynamicResource RepeatButtonBackground}" /> -->
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="MinWidth" Value="20" />
            <!--  第二个样式：作用于 ButtonSpinner 内部的 ContentPresenter  -->
            <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Opacity" Value="0.5" />
            </Style>
        </Style>
    </Style>
    <!--
    <Style Selector="NumericUpDown /template/ DataValidationErrors">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    -->

    <!--  // 更换 spinner 的主题，避免与其他控件的样式冲突，并设置样式  -->
    <Style Selector=":is(vbox|NumericUpDown)">

        <!-- <Style x:SetterTargetType="ButtonSpinner" Selector="^ /template/ #PART_Spinner"> -->
        <Style Selector="^ /template/ ButtonSpinner#PART_Spinner">
            <Style Selector="^:disabled /template/ StackPanel#PART_SpinnerPanel">
                <Setter Property="Background" Value="Transparent" />
            </Style>

            <Style Selector="^ /template/ :is(RepeatButton)">
                <Setter Property="Focusable" Value="False" />
            </Style>
        </Style>

    </Style>
</Styles>