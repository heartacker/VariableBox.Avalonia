<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StreamGeometry x:Key="ButtonSpinnerIncreaseButtonIcon">M0,5 L4.5,.5 9,5 6,5 4.5,3.5 3,5 z</StreamGeometry>
    <StreamGeometry x:Key="ButtonSpinnerDecreaseButtonIcon">M0,0 L3,0 4.5,1.5 6,0 9,0 4.5,4.5 z</StreamGeometry>
    <x:Double x:Key="ButtonSpinnerIncreaseButtonWidth">8</x:Double>

    <CornerRadius x:Key="ButtonSpinnerButtonGroupCornerRadius">1</CornerRadius>

    <Thickness x:Key="TextControlBorderThemeThickness">1</Thickness>
    <CornerRadius x:Key="ControlCornerRadius">1</CornerRadius>

    <StaticResource x:Key="VboxNumericUpDownBorderBrush" ResourceKey="ThemeBorderMidBrush" />
</ResourceDictionary>