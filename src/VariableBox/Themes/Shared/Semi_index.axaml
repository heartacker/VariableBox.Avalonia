<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="../Light/_index.axaml" />
                <ResourceInclude Source="../Light/Semi.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
        <!--  special  -->
        <ResourceDictionary x:Key="Dark">
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="../Dark/_index.axaml" />
                <ResourceInclude Source="../Dark/Semi.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!--  Add Resources Here  -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="SemiButtonSpinner.axaml" />
    </ResourceDictionary.MergedDictionaries>
</ResourceDictionary>