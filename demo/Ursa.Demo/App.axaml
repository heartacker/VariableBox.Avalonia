<Application
    x:Class="VariableBox.Demo.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:VariableBox.Demo.Converters"
    xmlns:semi="https://irihi.tech/semi"
    xmlns:v-semi="using:VariableBox.Avalonia.Themes.Semi"
    xmlns:vbox="VariableBox"
    RequestedThemeVariant="Light">
    <Application.DataTemplates>
        <!--<local:ViewLocator />-->
    </Application.DataTemplates>
    <Application.Styles>

        <semi:SemiTheme Locale="zh-CN" />
        <vbox:SemiTheme Locale="zh-CN" />

        <FluentTheme />
        <vbox:FluentTheme Locale="zh-CN" />

        <!--<SimpleTheme />
        <vbox:SimpleTheme Locale="zh-CN" />-->
    </Application.Styles>
</Application>