<Window
    x:Class="VariableBox.Demo.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Pages="clr-namespace:VariableBox.Demo.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:VariableBox.Demo.ViewModels"
    Title="VariableBox.Demo"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:CompileBindings="True"
    x:DataType="vm:MainWindowViewModel"
    Icon="/Assets/Ursa.ico"
    mc:Ignorable="d">
    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>
    <Grid RowDefinitions="30,*">
        <StackPanel
            Grid.Row="0"
            IsEnabled="True"
            StackPanel.Orientation="Horizontal">
            <!--<Button Click="Button_Click" Content="Switch" />-->
            <ToggleSwitch
                Command="{Binding ToggleThemeCommand}"
                IsChecked="True"
                IsEnabled="True"
                OffContent="{StaticResource SemiIconSun}"
                OnContent="{StaticResource SemiIconMoon}"
                Theme="{DynamicResource IconBorderlessToggleSwitch}" />
            <NumericUpDown />
            <TextBox
                VerticalAlignment="Center"
                VerticalContentAlignment="Center"
                InnerLeftContent="innertext"
                Text="Center" />
        </StackPanel>
        <Pages:NumericUpDownDemo Grid.Row="1" />
    </Grid>
</Window>